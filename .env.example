# Configuración PERSONAL. instalar.py copia este archivo como .env; completalo.
# .env no va a git: cada persona tiene el suyo.

# Cuenta DEMO del equipo en staging: dedicada, con permisos mínimos. Nunca
# una cuenta personal ni de producción.
DEMO_EMAIL=demo@tuapp.com
DEMO_PASSWORD=cambiame

# Opcional: otras cuentas de la misma liga demo, para las escenas que muestran
# lo que ve cada uno (CUENTA = "delegado", "jugador" o "veedor" en la escena).
# DEMO_DELEGADO_EMAIL=
# DEMO_DELEGADO_PASSWORD=
# DEMO_JUGADOR_EMAIL=
# DEMO_JUGADOR_PASSWORD=
# DEMO_VEEDOR_EMAIL=
# DEMO_VEEDOR_PASSWORD=

# La app que se graba. Los videos finales se graban contra staging, que tiene
# la liga demo (ver "Datos demo" en CONTRIBUTING.md). Local sirve para
# escribir y probar escenas, si tu base tiene los mismos datos.
APP_URL=https://staging.tuapp.com

# Opcional, para quien tiene el código de la PWA:
#   APP_DIR      carpeta del código (Claude la lee para sacar selectores).
#   APP_DEV_CMD  si está, el grabador levanta la app solo cuando no responde.
# APP_DIR=~/Documents/mi-pwa
# APP_DEV_CMD=npm run dev

# Opcional: carpeta de ffmpeg si no está en el PATH (ej. C:\ffmpeg\bin).
# FFMPEG_DIR=

# Opcional: voz oficial de Azure AI Speech para los videos finales
# (uv run --extra azure grabar.py … --proveedor-voz azure). Sin esto se usa
# edge-tts, que alcanza para borradores. Pedí la clave a quien administra el repo.
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=brazilsouth
